{
  "services": [
    {
      "service_name": "cgm-sanplat-api",
      "operational_secrets": [
        {"key": "WM_BASE_URL", "secret_id": "wm-base-url", "description": "URL HTTPS de WM", "required": true, "editable": true},
        {"key": "WM_USERNAME", "secret_id": "wm-username", "description": "Usuario de WM", "required": true, "editable": true},
        {"key": "WM_PASSWORD", "secret_id": "wm-password", "description": "Contraseña de WM", "required": true, "editable": true},
        {"key": "WM_API_KEY", "secret_id": "wm-api-key", "description": "API key opcional de WM", "required": false, "editable": true}
      ],
      "repository": "diegomad14/cgm-sanplat-api",
      "owner": "cgm",
      "cost_center": "cgm",
      "project_id": "cgm-assistant-prod",
      "region": "us-central1",
      "environment": "prod",
      "validation_targets": [
        { "name": "Perseo", "type": "external_source", "description": "KPI data source" },
        { "name": "FND", "type": "external_source", "description": "Field Network Device data" },
        { "name": "SanPlat", "type": "external_source", "description": "SanPlat integration" }
      ],
      "quality": { "enabled": true, "profile": "python", "coverage_threshold": 70 },
      "deployment": { "workflow_file": "platform-deploy.yml", "image_name": "cgm-sanplat-api", "artifact_repository": "cgm-sanplat-repo", "build_context": ".", "health_path": "/health" },
