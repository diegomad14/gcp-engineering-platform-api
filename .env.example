# Copy to .env (or export directly) before running `uvicorn`.
# NEVER put real secret/token values in this file or in .env — see
# docs/onboarding/new-developer-guide.md for the security Do/Don't.

# --- Required for local development without real GCP/GitHub credentials ---
ENG_PLATFORM_MOCK_MODE=true

# --- Optional integrations, only needed if you disable mock mode ---
# ENG_PLATFORM_BILLING_ENABLED=false
# ENG_PLATFORM_MONITORING_ENABLED=false
# ENG_PLATFORM_GCP_PROJECT_ID=

# GitHub deployments (see README.md "GitHub deployment configuration")
# ENG_PLATFORM_GITHUB_ENABLED=false
# ENG_PLATFORM_GITHUB_TOKEN=
# ENG_PLATFORM_GITHUB_DEPLOYMENT_WORKFLOW=platform-deploy.yml
# GCP_RELEASE_WIF_PROVIDER=projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL/providers/cgm-release-oidc
# ENG_PLATFORM_API_URL=https://eng-platform-api-xxxxx-uc.a.run.app
# ENG_PLATFORM_RELEASE_SIGNING_PRIVATE_KEY=  # Secret Manager only
# ENG_PLATFORM_RELEASE_SIGNING_PUBLIC_KEY=  # non-sensitive verification key
# ENG_PLATFORM_RELEASE_AUTH_FIRESTORE_COLLECTION=release_authorizations

# GitHub App and persistent release fallback
# ENG_PLATFORM_GITHUB_APP_ID=
# ENG_PLATFORM_GITHUB_INSTALLATION_ID=
# ENG_PLATFORM_GITHUB_PRIVATE_KEY=  # Secret Manager only
# ENG_PLATFORM_GITHUB_WEBHOOK_SECRET=  # Secret Manager only
# ENG_PLATFORM_GITHUB_BILLING_OWNER=diegomad14
# ENG_PLATFORM_GITHUB_INCLUDED_PRIVATE_MINUTES=2000
# ENG_PLATFORM_RELEASE_ORCHESTRATOR_ENABLED=false
# ENG_PLATFORM_RELEASE_CANARY_SERVICES=
# ENG_PLATFORM_RELEASE_ENABLED_SERVICES=
# ENG_PLATFORM_RELEASE_QUALITY_SERVICE_ACCOUNT=projects/PROJECT/serviceAccounts/quality@PROJECT.iam.gserviceaccount.com
# ENG_PLATFORM_RELEASE_CALLBACK_SERVICE_ACCOUNT=quality@PROJECT.iam.gserviceaccount.com
# ENG_PLATFORM_RELEASE_RECONCILER_SERVICE_ACCOUNT=  # dedicated scheduler identity
# ENG_PLATFORM_QUALITY_NODE_IMAGE=us-central1-docker.pkg.dev/PROJECT/REPOSITORY/quality-node@sha256:DIGEST
# ENG_PLATFORM_QUALITY_PYTHON_IMAGE=us-central1-docker.pkg.dev/PROJECT/REPOSITORY/quality-python@sha256:DIGEST
# ENG_PLATFORM_RELEASE_PLANNER_IMAGE=us-central1-docker.pkg.dev/PROJECT/REPOSITORY/release-planner@sha256:DIGEST
# ENG_PLATFORM_RELEASE_POSTGRES_IMAGE=postgres@sha256:DIGEST
# ENG_PLATFORM_GITHUB_HEALTH_REPOSITORY=diegomad14/gcp-engineering-platform-web

# Cloud Build Economy. Keep disabled until connection, IAM and callbacks exist.
# ENG_PLATFORM_CLOUD_BUILD_ENABLED=false
# ENG_PLATFORM_DEPLOY_EXECUTOR_MODE=auto
# ENG_PLATFORM_CLOUD_BUILD_PROJECT_ID=
# ENG_PLATFORM_CLOUD_BUILD_REGION=us-central1
# ENG_PLATFORM_CLOUD_BUILD_SERVICE_ACCOUNT=projects/PROJECT/serviceAccounts/deploy@PROJECT.iam.gserviceaccount.com
# ENG_PLATFORM_CLOUD_BUILD_CALLBACK_SERVICE_ACCOUNT=deploy@PROJECT.iam.gserviceaccount.com
# ENG_PLATFORM_RELEASE_EXECUTOR_IMAGE=us-central1-docker.pkg.dev/PROJECT/REPOSITORY/release-executor@sha256:DIGEST
# ENG_PLATFORM_CLOUD_BUILD_EVIDENCE_BUCKET=
# ENG_PLATFORM_CLOUD_BUILD_REPOSITORIES_JSON={}
# ENG_PLATFORM_CLOUD_BUILD_ENABLED_SERVICES=
# ENG_PLATFORM_CLOUD_BUILD_USAGE_ALERT_MINUTES=2000,2250,2500

# Quality report storage (see README.md "Quality report storage")
# ENG_PLATFORM_QUALITY_INGEST_TOKEN=
# ENG_PLATFORM_QUALITY_STORE_PATH=data
# ENG_PLATFORM_QUALITY_BUCKET=

# Operator authentication (see README.md "Operator authentication")
# ENG_PLATFORM_SESSION_SECRET=
# ENG_PLATFORM_FRONTEND_URL=http://localhost:5173
# ENG_PLATFORM_ALLOWED_GITHUB_LOGINS=
# ENG_PLATFORM_TRUST_IAP_IDENTITY=false
