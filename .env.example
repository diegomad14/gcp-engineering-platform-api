# Copy to .env (or export directly) before running `uvicorn`.
# NEVER put real secret/token values in this file or in .env — see
# docs/onboarding/new-developer-guide.md for the security Do/Don't.

# --- Required for local development without real GCP/GitHub credentials ---
ENG_PLATFORM_MOCK_MODE=true

# --- Optional integrations, only needed if you disable mock mode ---
# ENG_PLATFORM_BILLING_ENABLED=false
# ENG_PLATFORM_MONITORING_ENABLED=false
# ENG_PLATFORM_GCP_PROJECT_ID=

# GitHub deployments (see README.md "GitHub deployment configuration")
# ENG_PLATFORM_GITHUB_ENABLED=false
# ENG_PLATFORM_GITHUB_TOKEN=
# ENG_PLATFORM_GITHUB_DEPLOYMENT_WORKFLOW=platform-deploy.yml
# CGM_ACTIONS_RUNNER=  # only the exact cgm-release-local contingency value

# Quality report storage (see README.md "Quality report storage")
# ENG_PLATFORM_QUALITY_INGEST_TOKEN=
# ENG_PLATFORM_QUALITY_STORE_PATH=data

# Operator authentication (see README.md "Operator authentication")
# ENG_PLATFORM_SESSION_SECRET=
# ENG_PLATFORM_FRONTEND_URL=http://localhost:5173
# ENG_PLATFORM_ALLOWED_GITHUB_LOGINS=
