{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diegomad14/gcp-engineering-platform-api/schemas/gcp-service-release.schema.json",
  "title": "GCP Service Release Contract",
  "description": "Schema for one independently managed Cloud Run service.",
  "type": "object",
  "required": ["service", "release_target", "security"],
  "additionalProperties": false,
  "properties": {
    "service": {
      "type": "object",
      "required": ["name", "repository", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["api", "web", "worker", "integration"] }
      }
    },
    "release_target": {
      "type": "object",
      "required": ["platform", "service_name", "project_id", "region"],
      "additionalProperties": false,
      "properties": {
        "platform": { "type": "string", "const": "gcp-cloud-run" },
        "service_name": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "health_path": { "type": "string" },
        "openapi_path": { "type": "string" },
        "expected_openapi_paths": { "type": "integer", "minimum": 0 }
      }
    },
    "validation_targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "smoke_endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "path"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "expected_status": { "type": "integer" },
              "pii_safe": { "type": "boolean" },
              "external_source": { "type": "boolean" }
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quality_gate": {
          "type": "object",
          "required": ["enabled", "profile", "working_directory", "coverage_threshold", "blocking"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "profile": { "type": "string", "enum": ["python", "node", "static"] },
            "working_directory": { "type": "string", "minLength": 1 },
            "coverage_threshold": { "type": "number", "minimum": 0, "maximum": 100 },
            "blocking": { "type": "boolean" }
          }
        },
        "sonarqube": {
          "type": "object",
          "deprecated": true,
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "project_key": { "type": "string" },
            "blocking_quality_gate": { "type": "boolean" }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "required": ["workload_identity_provider", "deployer_service_account"],
      "additionalProperties": false,
      "properties": {
        "workload_identity_provider": { "type": "string", "minLength": 1 },
        "deployer_service_account": { "type": "string", "minLength": 1 },
        "forbidden": { "type": "array", "items": { "type": "string" } }
      }
    },
    "finops": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "service": { "type": "string" },
            "env": { "type": "string" },
            "owner": { "type": "string" },
            "cost_center": { "type": "string" }
          }
        }
      }
    }
  }
}
