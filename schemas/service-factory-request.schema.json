{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diegomad14/gcp-engineering-platform-api/schemas/service-factory-request.schema.json",
  "title": "Service Factory Request",
  "description": "Schema for service factory onboarding requests.",
  "type": "object",
  "required": [
    "repository",
    "service_name",
    "service_type",
    "runtime",
    "gcp_project",
    "owner"
  ],
  "additionalProperties": false,
  "properties": {
    "repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "maxLength": 256
    },
    "service_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?$",
      "maxLength": 63
    },
    "service_type": {
      "type": "string",
      "enum": [
        "api",
        "web",
        "worker",
        "integration"
      ]
    },
    "runtime": {
      "type": "string",
      "enum": [
        "python",
        "node",
        "static"
      ]
    },
    "gcp_project": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
    },
    "region": {
      "type": "string",
      "default": "us-central1",
      "pattern": "^[a-z]+(?:-[a-z]+)+[0-9]+$",
      "maxLength": 63
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_-]+$",
      "maxLength": 63
    },
    "cost_center": {
      "type": "string",
      "default": "",
      "pattern": "^[a-z0-9_-]*$",
      "maxLength": 63
    },
    "environment": {
      "type": "string",
      "enum": [
        "prod",
        "staging",
        "dev"
      ],
      "default": "prod"
    },
    "cloud_run_service_name": {
      "type": "string",
      "default": "",
      "deprecated": true,
      "description": "Deprecated image-name override only. Does not rename the Cloud Run resource; use service_name for its identity.",
      "pattern": "^(?:[a-z0-9][a-z0-9._-]*)?$",
      "maxLength": 128
    },
    "health_path": {
      "type": "string",
      "default": "/health",
      "pattern": "^/[^\\s]*$",
      "maxLength": 512
    },
    "openapi_path": {
      "type": "string",
      "default": "/openapi.json",
      "pattern": "^/[^\\s]*$",
      "maxLength": 512
    },
    "quality_profile": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "python",
        "node",
        "static",
        null
      ]
    },
    "quality_working_directory": {
      "type": "string",
      "default": ".",
      "pattern": "^(?:\\.|[A-Za-z0-9_-]+(?:[./][A-Za-z0-9_-]+)*)$",
      "maxLength": 256
    },
    "coverage_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 70
    },
    "sonar_project_key": {
      "type": "string",
      "default": "",
      "deprecated": true
    },
    "sonar_organization": {
      "type": "string",
      "default": "",
      "deprecated": true
    },
    "validation_targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "runtime_kind": {
      "type": "string",
      "enum": [
        "cloud_run_service",
        "cloud_run_job"
      ],
      "default": "cloud_run_service",
      "description": "Explicit Cloud Run resource kind; service_name remains the globally unique runtime ID."
    }
  }
}
