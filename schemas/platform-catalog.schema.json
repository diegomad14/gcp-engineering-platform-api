{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diegomad14/gcp-engineering-platform-api/schemas/platform-catalog.schema.json",
  "title": "Platform Service Catalog",
  "type": "object",
  "required": ["services"],
  "additionalProperties": false,
  "properties": {
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["service_name", "repository", "owner", "project_id", "region"],
        "additionalProperties": false,
        "properties": {
          "service_name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
          "repository": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "cost_center": { "type": "string" },
          "project_id": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 1 },
          "environment": { "type": "string" },
          "validation_targets": { "type": "array" },
          "quality": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "profile": { "type": ["string", "null"], "enum": ["python", "node", "static", null] },
              "coverage_threshold": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          },
          "finops": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "service": { "type": "string" },
              "env": { "type": "string" },
              "owner": { "type": "string" },
              "cost_center": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
