FROM python:3.12.11-slim-bookworm

ARG TRIVY_VERSION=0.72.0
ARG ACTIONLINT_VERSION=1.7.12

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl docker.io git nodejs npm socat \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir \
        bandit==1.8.6 \
        mypy==1.18.2 \
        pip-audit==2.9.0 \
        pytest-cov==7.0.0 \
        ruff==0.15.22 \
        semgrep==1.136.0 \
    && curl --fail --location --silent --show-error \
        "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" \
        | tar -xz -C /usr/local/bin trivy \
    && curl --fail --location --silent --show-error \
        "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_x86_64.tar.gz" \
        | tar -xz -C /usr/local/bin actionlint

COPY scripts/quality/quality_gate.py scripts/quality/differential_coverage.py /opt/eng-platform/
COPY docker/quality-executor/quality_executor.py docker/quality-executor/quality_profiles.py docker/quality-executor/untrusted_command.py docker/quality-executor/trusted_scanner.py docker/quality-executor/trusted_scanner.sh docker/quality-executor/api_container_smoke.sh docker/quality-executor/test_quality_executor.py /opt/eng-platform/
COPY src/eng_platform_api/release_quality_profiles.json /opt/eng-platform/release_quality_profiles.json
RUN mkdir -p /opt/eng-platform/trusted-bin \
    && install -m 0555 /opt/eng-platform/trusted_scanner.sh /opt/eng-platform/trusted-bin/semgrep \
    && install -m 0555 /opt/eng-platform/trusted_scanner.sh /opt/eng-platform/trusted-bin/trivy \
    && chmod 0555 /opt/eng-platform/quality_executor.py /opt/eng-platform/untrusted_command.py /opt/eng-platform/trusted_scanner.py /opt/eng-platform/api_container_smoke.sh \
    && chmod 0444 /opt/eng-platform/release_quality_profiles.json \
    && cd /opt/eng-platform \
    && PYTHONDONTWRITEBYTECODE=1 python3 -m unittest -v test_quality_executor.py

ENTRYPOINT ["python3", "/opt/eng-platform/quality_executor.py"]
